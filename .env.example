APP_ENV=local
APP_NAME=DevInsightAI
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://devinsight:change_me_dev@localhost:5432/devinsight
REDIS_URL=redis://localhost:6379/0

# Agent 用的模型。任何 OpenAI 兼容端点都行，base_url 必须显式填——
# 不做 provider → URL 的隐式映射，猜错域名只会得到连接超时，看起来像网络问题。
# 实测可用：
#   OpenRouter   https://openrouter.ai/api/v1          deepseek/deepseek-v4.1-flash
#   智谱 GLM     https://open.bigmodel.cn/api/paas/v4  glm-4-flash（免费档）
#   DeepSeek     https://api.deepseek.com/v1           deepseek-chat
# 不配的话 /api/v1/research 返回 503，其余接口不受影响。
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# 向量化只走本地模型（把全文发给第三方 API 会改变授权性质）
# onnx = 本地 ONNX 推理；hashing = 字符哈希假向量（仅测试）；disabled = 关闭
EMBEDDING_BACKEND=onnx
# 必须能覆盖中英混排。纯中文模型嵌英文会失真，bge-m3 的 ONNX 要 2 GB 以上
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# 必须与模型输出维度一致：这个值决定了 document_chunks.embedding 的 vector(N)。
# 改模型必须同时改这里并新写一条迁移重算，否则插入会直接报维度不匹配。
EMBEDDING_DIMENSIONS=384
# 留空则用 ~/.cache/devinsight/models/<模型名>
EMBEDDING_MODEL_DIR=

# 重排（cross-encoder）：把问句和候选文档拼成一条句子读一遍，直接给相关性打分。
# onnx = 本地 ONNX 推理；disabled = 不重排，直接用融合排序
RERANK_BACKEND=onnx
RERANK_MODEL=Xenova/bge-reranker-base
RERANK_MODEL_DIR=
# 只重排前多少条候选。40 条约 0.6 秒；再往上加，用户感知到的是延迟而不是准确率
RERANK_CANDIDATES=40

# 阶段 5 实时搜索：留空 = 关闭（/evidence 只返回本地证据，web_status=disabled）。
# 开发期不需要注册：PROVIDER=tavily + KEYLESS=true 就能用，约 30 次/天（每日额度，不是每小时）；
# 有 key 之后填 WEB_SEARCH_API_KEY，额度提到 1000 次/月，解析代码一行都不用改。
# TOPIC=news 才会返回 published_date——general 模式拿不到日期，等于放弃时效判断。
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_KEYLESS=true
WEB_SEARCH_TOPIC=news
WEB_SEARCH_DAYS=7

GITHUB_TOKEN=
HUGGINGFACE_TOKEN=

SECRET_KEY=replace_with_long_random_secret
ALLOWED_ORIGINS=http://localhost:3000

DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_LOCALE=zh-CN

MAX_RESEARCH_TOOL_CALLS=12
MAX_WEB_SEARCH_CALLS=4
MAX_AGENT_RUNTIME_SECONDS=180
